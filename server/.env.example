# Copy this file to ".env" (same folder) and fill in the values. Never commit ".env".
# On Render, set the same names under Environment in the service settings instead.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <user>, <password>, <cluster>.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nfc-verify?retryWrites=true&w=majority

# Password for the admin pages.
ADMIN_PASSWORD=

# Long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET signs admin login cookies. Changing it logs everyone out.
SESSION_SECRET=
# KEY_ENCRYPTION_SECRET encrypts tag keys and hashes scan IPs. Keep a backup:
# without it the stored keys cannot be read.
KEY_ENCRYPTION_SECRET=

# Optional (default 4000). Render sets this itself.
# PORT=4000
